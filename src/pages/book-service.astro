---
import BaseLayout from '../layouts/BaseLayout.astro';
import { businessConfig } from '../config/business';
import { integrationsConfig } from '../config/integrations';
import { Calendar, Clock, MapPin, CheckCircle2, ShieldCheck, Send, UploadCloud, Info } from 'lucide-astro';

const isCalendarActive = integrationsConfig.ghl.isCalendarActive && !!integrationsConfig.ghl.calendarEmbedUrl;
---

<BaseLayout
  title="Schedule Your Garage Door Service | Garage Doors Service Team Queens"
  description="Schedule your residential garage door repair, spring inspection, installation, or opener service appointment in Queens, NY."
  canonicalPath="/book-service"
>
  <!-- Page Header -->
  <section class="bg-primary text-white py-14 sm:py-20 border-b border-navy-700">
    <div class="container-custom max-w-4xl text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-700 text-accent text-xs font-semibold">
        <Calendar class="w-3.5 h-3.5" />
        <span>Convenient Scheduling</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
        Schedule Your Garage Door Service
      </h1>
      <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed">
        Tell us what you need help with and request a convenient appointment. Our team will follow up to confirm availability.
      </p>
    </div>
  </section>

  <!-- Main Booking Area -->
  <section class="py-16 md:py-24 bg-white border-b border-border">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Column: Booking Form or GHL Calendar Embed -->
        <div class="lg:col-span-7">
          {isCalendarActive ? (
            <!-- Real GHL Calendar Embed Iframe -->
            <div class="card-premium p-4 sm:p-6 bg-white border border-border shadow-elevated rounded-2xl overflow-hidden">
              <iframe
                src={integrationsConfig.ghl.calendarEmbedUrl}
                style="width: 100%; border:none; min-height: 700px;"
                id="ghl-calendar-frame"
                title="Schedule Service with Garage Doors Service Team Queens"
              ></iframe>
            </div>
          ) : (
            <!-- Dedicated Appointment Request Form -->
            <div class="card-premium p-6 sm:p-8 bg-white border border-border shadow-elevated rounded-2xl">
              <div class="mb-6 space-y-1.5 border-b border-border pb-4">
                <span class="inline-block px-2.5 py-1 rounded bg-accent/10 text-accent text-xs font-semibold uppercase tracking-wider">
                  Appointment Request
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-primary">
                  Choose Your Preferred Service Time
                </h3>
                <p class="text-xs sm:text-sm text-content-muted">
                  Provide your address and preferred appointment window. Our team will review your request and confirm appointment availability.
                </p>
              </div>

              <form id="booking-request-form" class="space-y-4" novalidate>
                <!-- Full Name & Phone -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="bookFullName" class="block text-xs font-semibold text-content-dark mb-1">
                      Full Name <span class="text-accent">*</span>
                    </label>
                    <input
                      type="text"
                      id="bookFullName"
                      name="bookFullName"
                      required
                      placeholder="e.g. Sarah Jenkins"
                      class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-surface-light text-sm text-content-dark focus:bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                    />
                    <p class="error-msg hidden text-xs text-red-500 mt-1" id="err-bookFullName">Full name is required.</p>
                  </div>

                  <div>
                    <label for="bookPhone" class="block text-xs font-semibold text-content-dark mb-1">
                      Phone Number <span class="text-accent">*</span>
                    </label>
                    <input
                      type="tel"
                      id="bookPhone"
                      name="bookPhone"
                      required
                      placeholder="e.g. (718) 555-0144"
                      class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-surface-light text-sm text-content-dark focus:bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                    />
                    <p class="error-msg hidden text-xs text-red-500 mt-1" id="err-bookPhone">Valid phone number required.</p>
                  </div>
                </div>

                <!-- Email & Service Type -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="bookEmail" class="block text-xs font-semibold text-content-dark mb-1">
                      Email Address <span class="text-accent">*</span>
                    </label>
                    <input
                      type="email"
                      id="bookEmail"
                      name="bookEmail"
                      required
                      placeholder="e.g. sarah@example.com"
                      class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-surface-light text-sm text-content-dark focus:bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                    />
                    <p class="error-msg hidden text-xs text-red-500 mt-1" id="err-bookEmail">Valid email is required.</p>
                  </div>

                  <div>
                    <label for="bookServiceType" class="block text-xs font-semibold text-content-dark mb-1">
                      Service Type <span class="text-accent">*</span>
                    </label>
                    <select
                      id="bookServiceType"
                      name="bookServiceType"
                      required
                      class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-surface-light text-sm text-content-dark focus:bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                    >
                      <option value="">Select service required</option>
                      {businessConfig.services.map((svc) => (
                        <option value={svc.id}>{svc.title}</option>
                      ))}
                      <option value="other">General Garage Door Assessment</option>
                    </select>
                    <p class="error-msg hidden text-xs text-red-500 mt-1" id="err-bookServiceType">Please select a service type.</p>
                  </div>
                </div>

                <!-- Service Address & ZIP Code -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div class="sm:col-span-2">
                    <label for="bookAddress" class="block text-xs font-semibold text-content-dark mb-1">
                      Service Address (Queens, NY) <span class="text-accent">*</span>
                    </label>
                    <input
                      type="text"
                      id="bookAddress"
                      name="bookAddress"
                      required
                      placeholder="e.g. 72-14 Austin St"
                      class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-surface-light text-sm text-content-dark focus:bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                    />
                    <p class="error-msg hidden text-xs text-red-500 mt-1" id="err-bookAddress">Address is required.</p>
                  </div>

                  <div>
                    <label for="bookZip" class="block text-xs font-semibold text-content-dark mb-1">
                      ZIP Code <span class="text-accent">*</span>
                    </label>
                    <input
                      type="text"
                      id="bookZip"
                      name="bookZip"
                      required
                      maxlength="5"
                      placeholder="e.g. 11375"
                      class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-surface-light text-sm text-content-dark focus:bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                    />
                    <p class="error-msg hidden text-xs text-red-500 mt-1" id="err-bookZip">5-digit Queens ZIP.</p>
                  </div>
                </div>

                <!-- Preferred Date & Preferred Time -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="bookDate" class="block text-xs font-semibold text-content-dark mb-1">
                      Preferred Date <span class="text-accent">*</span>
                    </label>
                    <input
                      type="date"
                      id="bookDate"
                      name="bookDate"
                      required
                      min={new Date().toISOString().split('T')[0]}
                      class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-surface-light text-sm text-content-dark focus:bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                    />
                    <p class="error-msg hidden text-xs text-red-500 mt-1" id="err-bookDate">Please choose a preferred date.</p>
                  </div>

                  <div>
                    <label for="bookTime" class="block text-xs font-semibold text-content-dark mb-1">
                      Preferred Time Window <span class="text-accent">*</span>
                    </label>
                    <select
                      id="bookTime"
                      name="bookTime"
                      required
                      class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-surface-light text-sm text-content-dark focus:bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                    >
                      <option value="">Select preferred time window</option>
                      <option value="morning">Morning (8:00 AM – 12:00 PM)</option>
                      <option value="afternoon">Afternoon (12:00 PM – 4:00 PM)</option>
                      <option value="late-afternoon">Late Afternoon (4:00 PM – 6:00 PM)</option>
                      <option value="flexible">Flexible / Any Available Window</option>
                    </select>
                    <p class="error-msg hidden text-xs text-red-500 mt-1" id="err-bookTime">Please pick a time preference.</p>
                  </div>
                </div>

                <!-- Problem Description -->
                <div>
                  <label for="bookDescription" class="block text-xs font-semibold text-content-dark mb-1">
                    Problem Description <span class="text-accent">*</span>
                  </label>
                  <textarea
                    id="bookDescription"
                    name="bookDescription"
                    rows="3"
                    required
                    placeholder="Describe your garage door issue or installation requirements..."
                    class="w-full px-3.5 py-2.5 rounded-lg border border-border bg-surface-light text-sm text-content-dark focus:bg-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
                  ></textarea>
                  <p class="error-msg hidden text-xs text-red-500 mt-1" id="err-bookDescription">Please briefly describe the issue.</p>
                </div>

                <!-- Optional Photo Upload -->
                <div>
                  <label class="block text-xs font-semibold text-content-dark mb-1">
                    Optional Photo Upload
                  </label>
                  <input
                    type="file"
                    id="bookPhoto"
                    name="bookPhoto"
                    accept="image/*"
                    class="block w-full text-xs text-content-muted file:mr-3 file:py-2 file:px-3.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary file:text-white hover:file:bg-secondary cursor-pointer"
                  />
                  <p class="text-[11px] text-gray-400 mt-1">Helps our technicians prepare appropriate replacement parts.</p>
                </div>

                <!-- Response Alert -->
                <div id="booking-feedback" class="hidden rounded-lg p-4 text-sm" role="alert"></div>

                <!-- Submit Button -->
                <div class="pt-2">
                  <button
                    type="submit"
                    id="booking-submit-btn"
                    class="btn-primary w-full py-3.5 text-base flex items-center justify-center gap-2 group"
                  >
                    <span class="btn-text">Submit Appointment Request</span>
                    <Send class="w-4 h-4 transition-transform group-hover:translate-x-1 btn-icon" />
                    <span class="spinner hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                  </button>
                </div>

                <div class="flex items-center justify-center gap-1.5 text-[11px] text-content-muted pt-1">
                  <ShieldCheck class="w-3.5 h-3.5 text-accent" />
                  <span>Submitting this form does not charge your card. Our team confirms exact arrival times.</span>
                </div>
              </form>
            </div>
          )}
        </div>

        <!-- Right Column: Booking Information & Confirmation Policy -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="card-premium p-6 sm:p-8 space-y-6 bg-surface-light border border-border">
            <h3 class="text-xl font-bold text-primary border-b border-border pb-3">
              How Scheduling Works
            </h3>
            
            <ul class="space-y-4 text-xs sm:text-sm text-content-muted">
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-accent text-white flex items-center justify-center shrink-0 font-bold text-xs mt-0.5">
                  1
                </div>
                <div>
                  <strong class="text-primary block">Submit Your Appointment Request</strong>
                  Select your preferred date, time window, and service address in Queens.
                </div>
              </li>

              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-accent text-white flex items-center justify-center shrink-0 font-bold text-xs mt-0.5">
                  2
                </div>
                <div>
                  <strong class="text-primary block">Team Follow-Up & Availability Check</strong>
                  Our dispatcher checks technician routing in your Queens neighborhood to confirm the window.
                </div>
              </li>

              <li class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-accent text-white flex items-center justify-center shrink-0 font-bold text-xs mt-0.5">
                  3
                </div>
                <div>
                  <strong class="text-primary block">Confirmed Appointment</strong>
                  You receive an appointment confirmation via email, phone, or SMS before the technician arrives.
                </div>
              </li>
            </ul>

            <div class="p-4 rounded-xl bg-white border border-border flex items-start gap-3 text-xs text-content-muted">
              <Info class="w-4 h-4 text-accent shrink-0 mt-0.5" />
              <p>
                <strong>Integrity Policy:</strong> We do not claim an appointment is locked in until our dispatch team or automated GHL calendar confirms availability with you.
              </p>
            </div>
          </div>

          <!-- Quick Contact Box -->
          <div class="p-6 rounded-2xl bg-primary text-white space-y-3">
            <h4 class="text-base font-bold text-white">Have An Urgent Question?</h4>
            <p class="text-xs text-gray-300 leading-relaxed">
              If your garage door is trapped or you need immediate guidance, you can also submit our direct contact form or chat with us.
            </p>
            <div class="pt-1">
              <a href="/contact" class="btn-primary text-xs py-2 px-4">
                Go to Contact Form
              </a>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ ghlWebhookUrl: integrationsConfig.ghl.webhookUrl }}>
  const form = document.getElementById('booking-request-form');
  const feedback = document.getElementById('booking-feedback');
  const submitBtn = document.getElementById('booking-submit-btn');
  const btnText = submitBtn?.querySelector('.btn-text');
  const btnIcon = submitBtn?.querySelector('.btn-icon');
  const spinner = submitBtn?.querySelector('.spinner');

  function validateField(id, condition) {
    const field = document.getElementById(id);
    const err = document.getElementById(`err-${id}`);
    if (!condition) {
      field?.classList.add('border-red-500');
      err?.classList.remove('hidden');
      return false;
    } else {
      field?.classList.remove('border-red-500');
      err?.classList.add('hidden');
      return true;
    }
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fullName = (document.getElementById('bookFullName') as HTMLInputElement)?.value.trim();
      const phone = (document.getElementById('bookPhone') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('bookEmail') as HTMLInputElement)?.value.trim();
      const serviceType = (document.getElementById('bookServiceType') as HTMLSelectElement)?.value;
      const address = (document.getElementById('bookAddress') as HTMLInputElement)?.value.trim();
      const zip = (document.getElementById('bookZip') as HTMLInputElement)?.value.trim();
      const date = (document.getElementById('bookDate') as HTMLInputElement)?.value;
      const time = (document.getElementById('bookTime') as HTMLSelectElement)?.value;
      const desc = (document.getElementById('bookDescription') as HTMLTextAreaElement)?.value.trim();

      const isNameOk = validateField('bookFullName', fullName.length >= 2);
      const isPhoneOk = validateField('bookPhone', /^[0-9+()\-.\s]{7,20}$/.test(phone));
      const isEmailOk = validateField('bookEmail', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email));
      const isSvcOk = validateField('bookServiceType', serviceType.length > 0);
      const isAddrOk = validateField('bookAddress', address.length >= 3);
      const isZipOk = validateField('bookZip', /^\d{5}$/.test(zip));
      const isDateOk = validateField('bookDate', date.length > 0);
      const isTimeOk = validateField('bookTime', time.length > 0);
      const isDescOk = validateField('bookDescription', desc.length >= 5);

      if (!isNameOk || !isPhoneOk || !isEmailOk || !isSvcOk || !isAddrOk || !isZipOk || !isDateOk || !isTimeOk || !isDescOk) {
        if (feedback) {
          feedback.className = 'rounded-lg p-4 text-sm bg-red-50 border border-red-200 text-red-800';
          feedback.textContent = 'Please complete all required fields correctly before submitting.';
          feedback.classList.remove('hidden');
        }
        return;
      }

      submitBtn?.setAttribute('disabled', 'true');
      btnText?.classList.add('opacity-50');
      btnIcon?.classList.add('hidden');
      spinner?.classList.remove('hidden');
      feedback?.classList.add('hidden');

      const payload = {
        fullName,
        phone,
        email,
        serviceType,
        address,
        zip,
        preferredDate: date,
        preferredTime: time,
        description: desc,
        source: 'Dedicated Booking Page',
        submittedAt: new Date().toISOString()
      };

      try {
        if (ghlWebhookUrl && ghlWebhookUrl.startsWith('http')) {
          const res = await fetch(ghlWebhookUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error('Network error');
        } else {
          console.info('GHL Webhook pending in integrations.js. Booking recorded locally:', payload);
          const bookings = JSON.parse(localStorage.getItem('preview_bookings') || '[]');
          bookings.push(payload);
          localStorage.setItem('preview_bookings', JSON.stringify(bookings));
        }

        if (feedback) {
          feedback.className = 'rounded-lg p-4 text-sm bg-green-50 border border-green-200 text-green-800 space-y-2';
          feedback.innerHTML = `
            <div class="font-bold text-base">Appointment Request Received</div>
            <p>Thank you, <strong>${fullName}</strong>! We have received your request for <strong>${date}</strong> (${time}) at <strong>${address}, Queens</strong>. Our dispatcher will review scheduling and contact you to confirm the appointment.</p>
          `;
          feedback.classList.remove('hidden');
        }
        form.reset();
      } catch (err) {
        if (feedback) {
          feedback.className = 'rounded-lg p-4 text-sm bg-red-50 border border-red-200 text-red-800';
          feedback.textContent = 'Failed to submit appointment request. Please contact us via phone or chat.';
          feedback.classList.remove('hidden');
        }
      } finally {
        submitBtn?.removeAttribute('disabled');
        btnText?.classList.remove('opacity-50');
        btnIcon?.classList.remove('hidden');
        spinner?.classList.add('hidden');
      }
    });
  }
</script>
