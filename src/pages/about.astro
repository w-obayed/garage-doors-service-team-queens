---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import CTASection from '../components/CTASection.astro';
import { ShieldCheck, MapPin, Users, HeartHandshake } from 'lucide-astro';
---

<BaseLayout
  title="About Us | Garage Doors Service Team Queens"
  description="Learn about Garage Doors Service Team Queens, our customer-focused philosophy, and our dedication to reliable residential garage door services in Queens, NY."
  canonicalPath="/about"
>
  <!-- Page Header -->
  <section class="bg-primary text-white py-14 sm:py-20 border-b border-navy-700">
    <div class="container-custom max-w-4xl text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-700 text-accent text-xs font-semibold">
        <Users class="w-3.5 h-3.5" />
        <span>About Our Company</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
        Dedicated to Queens Homeowners
      </h1>
      <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed">
        Garage Doors Service Team Queens provides attentive, professional garage door repair, installation, and maintenance across Queens, New York.
      </p>
    </div>
  </section>

  <!-- Story & Mission Section -->
  <section class="py-16 md:py-24 bg-white border-b border-border">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <div class="space-y-3">
            <span class="text-xs font-bold text-accent uppercase tracking-wider">
              Local Commitment
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-primary">
              Reliable Residential Garage Door Care
            </h2>
            <p class="text-base text-content-muted leading-relaxed">
              Your garage door is more than just an entry point—it protects your vehicles, secures your property, and serves as one of the most prominent architectural features of your home.
            </p>
            <p class="text-base text-content-muted leading-relaxed">
              At Garage Doors Service Team Queens, we understand that when a garage door malfunctions, it disrupts your daily schedule and creates safety concerns. That's why we focus on responsive communication, careful diagnostic evaluations, and practical solutions tailored to each customer's specific needs.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-surface-light border border-border space-y-1.5">
              <div class="w-8 h-8 rounded-lg bg-primary text-accent flex items-center justify-center mb-2">
                <MapPin class="w-4 h-4" />
              </div>
              <h4 class="font-bold text-sm text-primary">Queens Community Focus</h4>
              <p class="text-xs text-content-muted">
                Focused on neighborhoods across Queens, from Astoria to Bayside and beyond.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-surface-light border border-border space-y-1.5">
              <div class="w-8 h-8 rounded-lg bg-primary text-accent flex items-center justify-center mb-2">
                <HeartHandshake class="w-4 h-4" />
              </div>
              <h4 class="font-bold text-sm text-primary">Clear Communication</h4>
              <p class="text-xs text-content-muted">
                Straightforward service explanations without high-pressure sales tactics.
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden border border-border shadow-elevated bg-gray-100">
            <img
              src="/images/about/queens-residential.webp"
              alt="Suburban residential neighborhood in Queens, New York"
              class="w-full h-[400px] object-cover object-center"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white space-y-1">
              <p class="text-xs font-semibold uppercase text-accent">Serving Queens, NY</p>
              <p class="text-lg font-bold">Committed to Quality Residential Service</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Choose Us Component -->
  <WhyChooseUs />

  <!-- CTA Banner -->
  <CTASection
    title="Ready to Work With a Dedicated Local Team?"
    subtitle="Submit your service enquiry online or book an appointment convenient for your schedule."
  />
</BaseLayout>
