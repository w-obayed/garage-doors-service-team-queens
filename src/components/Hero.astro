---
import { businessConfig } from '../config/business';
import { Phone, Calendar, ArrowRight, ShieldCheck, CheckCircle2, MapPin } from 'lucide-astro';

const isPhoneVerified = businessConfig.verification.isPhoneVerified && !!businessConfig.contact.phone;
---

<section class="relative bg-gradient-to-b from-white via-surface-light to-white overflow-hidden py-12 md:py-16 lg:py-24 border-b border-border/60">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6 text-left">
        
        <!-- Local Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent/10 border border-accent/20 text-primary text-xs font-semibold tracking-wide">
          <MapPin class="w-3.5 h-3.5 text-accent" />
          <span>Local Service in Queens, New York</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[44px] xl:text-[50px] font-extrabold text-primary leading-[1.15] tracking-tight">
          Garage Door Services You Can Count On in <span class="text-accent">Queens</span>
        </h1>

        <!-- Subheading -->
        <p class="text-base sm:text-lg text-content-muted leading-relaxed max-w-2xl">
          Need help with your garage door? Garage Doors Service Team Queens is here to help with your garage door service needs. Contact our team to discuss your repair, installation, or maintenance project.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a
            href="/contact"
            class="btn-primary text-base py-3.5 px-7 flex items-center justify-center gap-2 group"
          >
            <span>Request Service</span>
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>

          {isPhoneVerified ? (
            <a
              href={`tel:${businessConfig.contact.phoneRaw || businessConfig.contact.phone}`}
              class="btn-outline text-base py-3.5 px-6 flex items-center justify-center gap-2"
            >
              <Phone class="w-4 h-4 text-accent" />
              <span>Call Now</span>
            </a>
          ) : (
            <a
              href="/book-service"
              class="btn-secondary text-base py-3.5 px-6 flex items-center justify-center gap-2"
            >
              <Calendar class="w-4 h-4 text-accent" />
              <span>Book Appointment</span>
            </a>
          )}
        </div>

        <!-- Trust Indicators (Confirmed claims only) -->
        <div class="pt-6 border-t border-border grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs sm:text-sm text-content-dark font-medium">
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-accent shrink-0" />
            <span>Residential Garage Doors</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-accent shrink-0" />
            <span>Convenient Service Requests</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-accent shrink-0" />
            <span>Easy Online Communication</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Showcase -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Ambient decorative card halo -->
          <div class="absolute -inset-2 bg-gradient-to-r from-accent/20 to-secondary/15 rounded-2xl blur-lg opacity-75"></div>
          
          <div class="relative rounded-2xl overflow-hidden border-2 border-white shadow-2xl bg-white">
            <img
              src="/images/hero/garage-hero.webp"
              alt="Modern residential garage door on an American suburban home"
              class="w-full h-[360px] sm:h-[420px] object-cover object-center transform hover:scale-[1.02] transition-transform duration-500"
              loading="eager"
            />
            
            <!-- Floating Service Badge Overlay -->
            <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md p-4 rounded-xl shadow-lg border border-border">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs font-semibold text-accent uppercase tracking-wider">Service Coverage</p>
                  <p class="text-sm font-bold text-primary">All Boroughs & Neighborhoods in Queens</p>
                </div>
                <div class="w-9 h-9 rounded-full bg-accent/10 flex items-center justify-center shrink-0">
                  <ShieldCheck class="w-5 h-5 text-accent" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
