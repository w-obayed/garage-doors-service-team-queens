---
import { ArrowRight, Check } from 'lucide-astro';

interface Props {
  id: string;
  title: string;
  shortDesc: string;
  image: string;
  features?: string[];
}

const { id, title, shortDesc, image, features = [] } = Astro.props;
---

<div class="card-premium flex flex-col h-full overflow-hidden group">
  <!-- Image Header -->
  <div class="relative h-52 sm:h-56 overflow-hidden bg-gray-100">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-primary/60 via-transparent to-transparent opacity-80"></div>
    <div class="absolute bottom-3 left-4 right-4">
      <span class="inline-block px-2.5 py-1 rounded bg-accent text-white text-xs font-semibold uppercase tracking-wider">
        Queens Service
      </span>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-6 flex flex-col flex-grow justify-between space-y-4">
    <div class="space-y-3">
      <h3 class="text-xl font-bold text-primary group-hover:text-accent transition-colors">
        {title}
      </h3>
      <p class="text-sm text-content-muted leading-relaxed">
        {shortDesc}
      </p>

      {features.length > 0 && (
        <ul class="pt-2 space-y-1.5 text-xs text-content-dark">
          {features.slice(0, 3).map((feature) => (
            <li class="flex items-center gap-2">
              <Check class="w-3.5 h-3.5 text-accent shrink-0" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Actions -->
    <div class="pt-4 border-t border-border flex items-center justify-between gap-3">
      <a
        href={`/services#${id}`}
        class="text-xs font-semibold text-secondary hover:text-accent flex items-center gap-1 transition-colors"
      >
        <span>Learn More</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>

      <a
        href={`/contact?service=${encodeURIComponent(id)}`}
        class="btn-primary text-xs py-2 px-3.5 shadow-none"
      >
        Request Service
      </a>
    </div>
  </div>
</div>
