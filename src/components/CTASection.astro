---
import { Calendar, ArrowRight, ShieldCheck } from 'lucide-astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Ready to Discuss Your Garage Door Project in Queens?",
  subtitle = "Contact Garage Doors Service Team Queens today. We evaluate your garage door symptoms and provide straightforward service options."
} = Astro.props;
---

<section class="py-16 md:py-20 bg-primary text-white relative overflow-hidden">
  <!-- Subtle background ambient design -->
  <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-secondary/30 blur-3xl pointer-events-none"></div>
  <div class="absolute -left-20 -top-20 w-80 h-80 rounded-full bg-accent/15 blur-3xl pointer-events-none"></div>

  <div class="container-custom relative z-10 text-center max-w-4xl mx-auto space-y-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-accent text-xs font-semibold">
      <ShieldCheck class="w-3.5 h-3.5" />
      <span>Serving Residential Homeowners in Queens</span>
    </div>

    <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
      {title}
    </h2>

    <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto leading-relaxed">
      {subtitle}
    </p>

    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/contact"
        class="btn-primary text-base py-3.5 px-8 flex items-center justify-center gap-2 group w-full sm:w-auto"
      >
        <span>Request Service</span>
        <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </a>

      <a
        href="/book-service"
        class="inline-flex items-center justify-center font-medium px-8 py-3.5 rounded-lg border-2 border-white/20 hover:border-white text-white hover:bg-white/10 transition-all duration-200 text-base w-full sm:w-auto gap-2"
      >
        <Calendar class="w-4 h-4 text-accent" />
        <span>Book an Appointment</span>
      </a>
    </div>
  </div>
</section>
