---
import { businessConfig } from '../config/business';
import { Phone, Calendar, Menu, X, ChevronRight } from 'lucide-astro';

const currentPath = Astro.url.pathname;
const isPhoneVerified = businessConfig.verification.isPhoneVerified && !!businessConfig.contact.phone;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Our Work' },
  { href: '/about', label: 'About Us' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/#faq', label: 'FAQs' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-border shadow-sm transition-all duration-200" id="site-header">
  <!-- Top notification / Queens service announcement bar -->
  <div class="bg-primary text-white text-xs py-1.5 px-4">
    <div class="container-custom flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="font-medium text-gray-200">Residential Garage Door Services in Queens, New York</span>
      </div>
      <div class="hidden sm:flex items-center gap-4 text-gray-300">
        <span>Convenient Service Requests</span>
        <span class="text-gray-500">•</span>
        <a href="/contact" class="hover:text-accent transition-colors font-medium">Inquire Online</a>
      </div>
    </div>
  </div>

  <div class="container-custom">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo & Name -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-accent rounded-lg p-1" aria-label="Garage Doors Service Team Queens Home">
        <img src="/images/logo.svg" alt="Garage Doors Service Team Queens" class="h-11 w-auto transition-transform duration-200 group-hover:scale-[1.02]" />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href) && !link.href.includes('#'));
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150 ${
                isActive
                  ? 'text-accent font-semibold bg-accent-light/60'
                  : 'text-content-dark hover:text-accent hover:bg-gray-light'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        {isPhoneVerified ? (
          <a
            href={`tel:${businessConfig.contact.phoneRaw || businessConfig.contact.phone}`}
            class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-lg border border-border text-primary font-semibold text-sm hover:border-accent hover:text-accent transition-all duration-200"
            aria-label={`Call ${businessConfig.contact.phone}`}
          >
            <Phone class="w-4 h-4 text-accent" />
            <span>{businessConfig.contact.phone}</span>
          </a>
        ) : (
          <a
            href="/contact"
            class="hidden md:inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-content-muted hover:text-primary text-sm font-medium transition-colors"
          >
            <span>Need Assistance?</span>
          </a>
        )}

        <a
          href="/book-service"
          class="btn-primary text-sm py-2.5 px-4 shadow-sm hover:shadow-md flex items-center gap-2"
        >
          <Calendar class="w-4 h-4" />
          <span>Book a Service</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 lg:hidden">
        {isPhoneVerified && (
          <a
            href={`tel:${businessConfig.contact.phoneRaw || businessConfig.contact.phone}`}
            class="p-2.5 text-accent hover:bg-accent-light rounded-lg border border-border"
            aria-label="Call Now"
          >
            <Phone class="w-5 h-5" />
          </a>
        )}
        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2.5 text-content-dark hover:text-accent hover:bg-gray-light rounded-lg border border-border focus:outline-none focus:ring-2 focus:ring-accent"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
          aria-controls="mobile-navigation"
        >
          <Menu class="w-6 h-6 menu-open-icon" />
          <X class="w-6 h-6 menu-close-icon hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div
    id="mobile-navigation"
    class="hidden lg:hidden border-t border-border bg-white px-4 pt-3 pb-6 space-y-3 shadow-xl transition-all duration-300"
  >
    <div class="flex flex-col space-y-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`flex items-center justify-between px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
              isActive
                ? 'text-accent font-semibold bg-accent-light'
                : 'text-content-dark hover:bg-gray-light hover:text-accent'
            }`}
          >
            <span>{link.label}</span>
            <ChevronRight class="w-4 h-4 text-gray-400" />
          </a>
        );
      })}
    </div>

    <div class="pt-3 border-t border-border flex flex-col gap-2.5">
      {isPhoneVerified && (
        <a
          href={`tel:${businessConfig.contact.phoneRaw || businessConfig.contact.phone}`}
          class="btn-secondary w-full py-3 text-center flex items-center justify-center gap-2"
        >
          <Phone class="w-4 h-4 text-accent" />
          <span>Call: {businessConfig.contact.phone}</span>
        </a>
      )}

      <a
        href="/book-service"
        class="btn-primary w-full py-3 text-center flex items-center justify-center gap-2"
      >
        <Calendar class="w-4 h-4" />
        <span>Book an Appointment</span>
      </a>
      
      <a
        href="/contact"
        class="text-center text-sm text-content-muted hover:text-primary py-1 font-medium"
      >
        Submit Service Enquiry
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-navigation');
  const openIcon = toggleBtn?.querySelector('.menu-open-icon');
  const closeIcon = toggleBtn?.querySelector('.menu-close-icon');

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      
      if (isExpanded) {
        mobileNav.classList.add('hidden');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      } else {
        mobileNav.classList.remove('hidden');
        openIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      }
    });

    // Close when clicking a nav link
    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });
  }
</script>
