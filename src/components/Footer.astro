---
import { businessConfig } from '../config/business';
import { MapPin, Phone, Mail, Clock, MessageSquare, Shield, ArrowRight } from 'lucide-astro';

const isPhoneVerified = businessConfig.verification.isPhoneVerified && !!businessConfig.contact.phone;
const isEmailVerified = businessConfig.verification.isEmailVerified && !!businessConfig.contact.email;
const isHoursVerified = businessConfig.verification.isHoursVerified && !!businessConfig.contact.hours;
const isWhatsAppVerified = businessConfig.verification.isWhatsAppVerified && !!businessConfig.contact.whatsAppNumber;
---

<footer class="bg-primary text-white border-t border-navy-700 pt-16 pb-8">
  <div class="container-custom">
    <!-- Top 4 Columns Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-navy-700/80">
      
      <!-- Col 1: Business Info -->
      <div class="space-y-4">
        <a href="/" class="inline-block" aria-label="Garage Doors Service Team Queens">
          <img src="/images/logo-white.svg" alt="Garage Doors Service Team Queens" class="h-10 w-auto" />
        </a>
        <p class="text-gray-300 text-sm leading-relaxed">
          Garage door service enquiries in Queens, New York. We assist local homeowners with repair evaluations, spring services, installations, opener diagnostics, and preventative maintenance.
        </p>
        <div class="pt-2">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-navy-700/60 border border-navy-600 text-xs text-gray-200">
            <MapPin class="w-3.5 h-3.5 text-accent" />
            <span>Serving Queens, New York</span>
          </div>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h3 class="text-base font-semibold text-white uppercase tracking-wider mb-4 border-l-2 border-accent pl-2.5">
          Quick Links
        </h3>
        <ul class="space-y-2.5 text-sm text-gray-300">
          <li>
            <a href="/" class="hover:text-accent transition-colors flex items-center gap-1.5">
              <span class="text-accent text-xs">›</span> Home
            </a>
          </li>
          <li>
            <a href="/services" class="hover:text-accent transition-colors flex items-center gap-1.5">
              <span class="text-accent text-xs">›</span> Services
            </a>
          </li>
          <li>
            <a href="/work" class="hover:text-accent transition-colors flex items-center gap-1.5">
              <span class="text-accent text-xs">›</span> Our Work
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-accent transition-colors flex items-center gap-1.5">
              <span class="text-accent text-xs">›</span> About Us
            </a>
          </li>
          <li>
            <a href="/reviews" class="hover:text-accent transition-colors flex items-center gap-1.5">
              <span class="text-accent text-xs">›</span> Reviews
            </a>
          </li>
          <li>
            <a href="/#faq" class="hover:text-accent transition-colors flex items-center gap-1.5">
              <span class="text-accent text-xs">›</span> FAQs
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-accent transition-colors flex items-center gap-1.5">
              <span class="text-accent text-xs">›</span> Contact
            </a>
          </li>
          <li>
            <a href="/book-service" class="hover:text-accent transition-colors flex items-center gap-1.5 font-medium text-accent">
              <span class="text-accent text-xs">›</span> Book an Appointment
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Services -->
      <div>
        <h3 class="text-base font-semibold text-white uppercase tracking-wider mb-4 border-l-2 border-accent pl-2.5">
          Our Services
        </h3>
        <ul class="space-y-2.5 text-sm text-gray-300">
          {businessConfig.services.map((service) => (
            <li>
              <a href={`/services#${service.id}`} class="hover:text-accent transition-colors flex items-center gap-1.5">
                <span class="text-accent text-xs">›</span> {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact Details -->
      <div>
        <h3 class="text-base font-semibold text-white uppercase tracking-wider mb-4 border-l-2 border-accent pl-2.5">
          Contact & Inquiries
        </h3>
        <ul class="space-y-3 text-sm text-gray-300">
          <li class="flex items-start gap-3">
            <MapPin class="w-4 h-4 text-accent shrink-0 mt-0.5" />
            <div>
              <p class="font-medium text-white">Service Location</p>
              <p class="text-gray-300">Queens, New York, USA</p>
            </div>
          </li>

          {isPhoneVerified && (
            <li class="flex items-start gap-3">
              <Phone class="w-4 h-4 text-accent shrink-0 mt-0.5" />
              <div>
                <p class="font-medium text-white">Phone</p>
                <a href={`tel:${businessConfig.contact.phoneRaw || businessConfig.contact.phone}`} class="hover:text-accent">
                  {businessConfig.contact.phone}
                </a>
              </div>
            </li>
          )}

          {isEmailVerified && (
            <li class="flex items-start gap-3">
              <Mail class="w-4 h-4 text-accent shrink-0 mt-0.5" />
              <div>
                <p class="font-medium text-white">Email</p>
                <a href={`mailto:${businessConfig.contact.email}`} class="hover:text-accent break-all">
                  {businessConfig.contact.email}
                </a>
              </div>
            </li>
          )}

          {isHoursVerified && (
            <li class="flex items-start gap-3">
              <Clock class="w-4 h-4 text-accent shrink-0 mt-0.5" />
              <div>
                <p class="font-medium text-white">Business Hours</p>
                <p class="text-gray-300">{businessConfig.contact.hours}</p>
              </div>
            </li>
          )}

          {isWhatsAppVerified && (
            <li class="flex items-start gap-3">
              <MessageSquare class="w-4 h-4 text-green-400 shrink-0 mt-0.5" />
              <div>
                <p class="font-medium text-white">WhatsApp</p>
                <a
                  href={`https://wa.me/${businessConfig.contact.whatsAppNumber}?text=${encodeURIComponent(businessConfig.contact.whatsAppPrefillMessage)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-green-400 hover:underline"
                >
                  Message On WhatsApp
                </a>
              </div>
            </li>
          )}

          <li class="pt-2">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 text-xs font-semibold text-accent hover:text-white transition-colors"
            >
              <span>Submit Service Request Form</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <p>
        &copy; {new Date().getFullYear()} {businessConfig.legalName}. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms and Conditions</a>
        <a href="/book-service" class="hover:text-white transition-colors">Book Online</a>
      </div>
    </div>
  </div>
</footer>
