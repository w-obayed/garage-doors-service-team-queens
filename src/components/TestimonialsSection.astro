---
import { Star, MessageSquare, ExternalLink, ShieldCheck } from 'lucide-astro';

/**
 * Notice:
 * The marketing audit identified an active Google Business Profile with customer reviews.
 * In accordance with strict integrity guidelines:
 * - We NEVER fabricate customer names, star ratings, or review quotes.
 * - This component provides verified review presentation infrastructure.
 * - Once the verified GBP reviews are linked or exported, they populate the cards below.
 */

// Toggle this flag once verified Google reviews are imported
const hasVerifiedReviews = false;

interface VerifiedReview {
  name: string;
  rating: number;
  date: string;
  text: string;
  serviceType?: string;
}

const verifiedReviews: VerifiedReview[] = [];
---

<section class="py-16 md:py-24 bg-white border-b border-border" id="testimonials">
  <div class="container-custom">
    
    <!-- Section Heading -->
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-primary text-xs font-semibold">
        <Star class="w-3.5 h-3.5 text-accent fill-accent" />
        <span>Customer Feedback</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight">
        What Our Customers Say
      </h2>
      <p class="text-content-muted text-base">
        Authentic service experiences from homeowners across Queens, New York.
      </p>
    </div>

    {hasVerifiedReviews && verifiedReviews.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {verifiedReviews.map((rev) => (
          <div class="card-premium p-6 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center gap-1 text-accent">
                {Array.from({ length: rev.rating }).map(() => (
                  <Star class="w-4 h-4 fill-accent text-accent" />
                ))}
              </div>
              <p class="text-sm text-content-dark italic leading-relaxed">
                "{rev.text}"
              </p>
            </div>
            <div class="pt-4 border-t border-border flex items-center justify-between text-xs">
              <span class="font-bold text-primary">{rev.name}</span>
              <span class="text-content-muted">{rev.date}</span>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <!-- Neutral Professional Placeholder & Google Review Hub -->
      <div class="max-w-3xl mx-auto card-premium p-8 sm:p-10 text-center space-y-6 border-dashed border-2 border-border bg-surface-light">
        <div class="w-16 h-16 rounded-full bg-accent/10 text-accent mx-auto flex items-center justify-center">
          <MessageSquare class="w-8 h-8" />
        </div>
        
        <div class="space-y-2 max-w-xl mx-auto">
          <h3 class="text-xl font-bold text-primary">
            Google Business Profile Reviews
          </h3>
          <p class="text-sm text-content-muted leading-relaxed">
            We are syncing our direct customer feedback from our official Google Business Profile. We believe in 100% genuine customer reviews without invented testimonials.
          </p>
        </div>

        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-border text-xs text-content-muted">
          <ShieldCheck class="w-4 h-4 text-accent" />
          <span>Verified review transparency policy active</span>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="https://www.google.com/maps/search/?api=1&query=Garage+Doors+Service+Team+Queens"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary text-xs sm:text-sm py-3 px-6 flex items-center gap-2"
          >
            <span>Read More Google Reviews</span>
            <ExternalLink class="w-4 h-4" />
          </a>

          <a
            href="/contact"
            class="btn-primary text-xs sm:text-sm py-3 px-6"
          >
            Leave Your Service Enquiry
          </a>
        </div>
      </div>
    )}

  </div>
</section>
