---
import { MessageSquare, Wrench, FileText, Calendar, MapPin, CheckCircle } from 'lucide-astro';

const reasons = [
  {
    icon: MessageSquare,
    title: "Convenient Communication",
    description: "Contact the team through available communication channels including online forms, chat, and phone."
  },
  {
    icon: Wrench,
    title: "Service-Focused Approach",
    description: "Explain your garage door issue and discuss possible repair, replacement, or maintenance solutions."
  },
  {
    icon: FileText,
    title: "Easy Service Requests",
    description: "Submit your details and door symptoms quickly through our straightforward website request forms."
  },
  {
    icon: Calendar,
    title: "Simple Booking Process",
    description: "Request an appointment online with your preferred date and time for convenient service scheduling."
  },
  {
    icon: MapPin,
    title: "Local Service Focus",
    description: "Dedicated to serving residential customers throughout Queens, New York and nearby neighborhoods."
  }
];
---

<section class="py-16 md:py-24 bg-white border-b border-border">
  <div class="container-custom">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Visual Side -->
      <div class="lg:col-span-5 relative order-2 lg:order-1">
        <div class="relative rounded-2xl overflow-hidden border border-border shadow-elevated bg-gray-50">
          <img
            src="/images/about/technician.webp"
            alt="Garage door technician preparing diagnostic equipment"
            class="w-full h-[440px] object-cover object-top"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent"></div>
          
          <div class="absolute bottom-6 left-6 right-6 text-white space-y-2">
            <span class="inline-block px-3 py-1 rounded bg-accent text-white text-xs font-semibold uppercase">
              Local Commitment
            </span>
            <h4 class="text-lg font-bold text-white">Residential Care Across Queens</h4>
            <p class="text-xs text-gray-200">
              Clear communication and straightforward service from the moment you get in touch.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Content Side -->
      <div class="lg:col-span-7 space-y-8 order-1 lg:order-2">
        
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-primary text-xs font-semibold">
            <CheckCircle class="w-3.5 h-3.5 text-accent" />
            <span>Customer Focused</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-primary tracking-tight">
            Why Choose Garage Doors Service Team Queens?
          </h2>
          <p class="text-content-muted text-base leading-relaxed">
            We prioritize straightforward communication, convenient scheduling, and attentive service for every homeowner in Queens.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {reasons.map((item, index) => {
            const Icon = item.icon;
            return (
              <div class={`p-5 rounded-xl border border-border/70 bg-surface-light hover:border-accent/40 transition-colors ${index === 4 ? 'sm:col-span-2' : ''}`}>
                <div class="w-10 h-10 rounded-lg bg-primary text-accent flex items-center justify-center mb-3">
                  <Icon class="w-5 h-5" />
                </div>
                <h3 class="text-base font-bold text-primary mb-1.5">{item.title}</h3>
                <p class="text-xs sm:text-sm text-content-muted leading-relaxed">{item.description}</p>
              </div>
            );
          })}
        </div>

        <div class="pt-2">
          <a href="/contact" class="btn-primary text-sm">
            Discuss Your Service Project
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
